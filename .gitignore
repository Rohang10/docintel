# =====================================================================
# Docintel Monorepo .gitignore
# Prevents sensitive environment variables, secrets, databases,
# document storage vaults, and build artifacts from reaching Git
# =====================================================================

# --- Secret Environment Files ---
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Certificates & API Keys ---
*.pem
*.key
*.crt
*.pfx
secrets/

# --- Backend Database & Vault Storage ---
docintel.db
*.db
*.sqlite
*.sqlite3
storage_vault/
storage/
uploads/

# --- Python & FastAPI Cache / Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend Build Outputs ---
node_modules/
.next/
out/
build/
dist/
.turbo/
.cache/
.parcel-cache/

# --- Package Manager Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS & Editor Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
*.log
